digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.12, ranksep=0.35, pad=0.2, splines=ortho];
  node  [shape=box, style="filled", fillcolor="#FFFFFF", color="#444444", fontname="DejaVu Sans", fontsize=9, margin="0.08,0.04"];
  edge  [color="#666666", arrowhead=none];
  root [label="MLOps pipeline for flight\narrival-delay prediction", fillcolor="#E4ECF7", fontsize=11];
  p1 [label="1 Project\nmanagement", fillcolor="#F2F2F2"];
  p2 [label="2 Data", fillcolor="#F2F2F2"];
  p3 [label="3 Modelling", fillcolor="#F2F2F2"];
  p4 [label="4 Deployment", fillcolor="#F2F2F2"];
  p5 [label="5 Monitoring and\nretraining", fillcolor="#F2F2F2"];
  p6 [label="6 Evaluation", fillcolor="#F2F2F2"];
  p7 [label="7 Report", fillcolor="#F2F2F2"];
  root -> {p1 p2 p3 p4 p5 p6 p7};
  p1 -> a1 -> a2 -> a3 -> a4;
  a1 [label="1.1 Decision log"]; a2 [label="1.2 Issue log"]; a3 [label="1.3 Schedule, gates"]; a4 [label="1.4 AI-use record"];
  p2 -> b1 -> b2 -> b3 -> b4;
  b1 [label="2.1 Acquisition"]; b2 [label="2.2 Ingestion\n(Parquet, manifest)"]; b3 [label="2.3 Validation,\nquarantine"]; b4 [label="2.4 Feature\ncontract"];
  p3 -> c1 -> c2 -> c3 -> c4;
  c1 [label="3.1 Reference\nmodels"]; c2 [label="3.2 Candidate\nmodels"]; c3 [label="3.3 Training,\ntracking"]; c4 [label="3.4 E1/E2 grid,\nselection"];
  p4 -> d1 -> d2 -> d3 -> d4;
  d1 [label="4.1 Bundle,\nregistry"]; d2 [label="4.2 FastAPI\nservice"]; d3 [label="4.3 Docker\nimage"]; d4 [label="4.4 CI/CD"];
  p5 -> e1 -> e2 -> e3 -> e4;
  e1 [label="5.1 Signals"]; e2 [label="5.2 Policy"]; e3 [label="5.3 Registry\noperations"]; e4 [label="5.4 Replay\nengine"];
  p6 -> f1 -> f2 -> f3;
  f1 [label="6.1 E3 replay"]; f2 [label="6.2 Design\nfreeze"]; f3 [label="6.3 E4 holdout"];
  p7 -> g1 -> g2 -> g3;
  g1 [label="7.1 Literature"]; g2 [label="7.2 Sections\n1-13"]; g3 [label="7.3 Final\ndocument"];
}
